includes:
    - vendor/a8csp/configs/php/quality-assurance/phpstan.dist.neon

parameters:
    scanDirectories:
        - vendor/wp-plugin/woocommerce
    # The entry file's name is per-repository and footprint.php is a root data manifest, so both
    # are listed here.
    paths:
        - %currentWorkingDirectory%/a8csp-template-plugin.php
        - %currentWorkingDirectory%/footprint.php
    WPCompat:
        # wp-compat's fallback finds the entry file only when the checkout directory shares its name.
        pluginFile: %currentWorkingDirectory%/a8csp-template-plugin.php
