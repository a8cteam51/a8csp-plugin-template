{
  "$schema": "https://schemas.wp.org/trunk/wp-env.schema.json",
  "phpVersion": "8.5",
  "port": 8893,
  "testsEnvironment": false,
  "mappings": {
    "wp-content/plugins/a8csp-template-plugin": ".",
    "wp-content/plugins/woocommerce": "./vendor/wp-plugin/woocommerce"
  },
  "lifecycleScripts": {
    "afterStart": "wp-env run cli wp plugin activate woocommerce a8csp-template-plugin"
  },
  "config": {
    "WP_DEBUG": true,
    "SCRIPT_DEBUG": true
  }
}
