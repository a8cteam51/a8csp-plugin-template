# wp dist-archive walks the disk, not git, so vendor/ and the committed build output ship and
# this file removes everything else. `/build` holds Infection's logs; blocks/build and the
# assets/*/build directories ship.

.git*
.idea
.vscode
.distignore
node_modules
tests
changelog
bin
/build
vendor/bin
*.dist.xml
.wp-env*.json
.phpcs.xml
.phpcs.tests.xml
.phpstan.neon
infection.json
playwright.config.js
postcss.config.js
eslint.config.mjs
stylelint.config.js
.editorconfig
.DS_Store
package*.json
composer.json
composer.lock
/docs
AGENTS.md
CLAUDE.md
.agents

# Secret material — never ship, even if a consumer forgets to list it.
# .pem/.key are root-anchored (leading /) so certs bundled under vendor/
# (e.g. CA bundles) still ship.
.env*
/*.pem
/*.key
id_rsa*
.npmrc
auth.json
